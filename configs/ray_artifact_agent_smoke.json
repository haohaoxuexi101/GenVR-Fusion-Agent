{
  "run_name": "ray_artifact_attribution_smoke",
  "case": "lattice",
  "nx": 24,
  "ny": 24,
  "boundary_ckpt": "outputs/hpc_v2_models/boundary_900k_100ep/best.pt",
  "internal_ckpt": "outputs/hpc_v2_models/internal_900k_100ep/best.pt",
  "device": "auto",
  "dtype": "float64",
  "oracle_mc_dtype": "float64",
  "inference_batch_size": 2048,
  "rk4_steps": 12,
  "rtol": 1e-8,
  "max_iters": 1000,
  "dense_n_mu": 2,
  "dense_n_phi": 16,
  "dense_rtol": 1e-7,
  "dense_max_iters": 600,
  "check_every": 4,
  "response_cache_dir": "outputs/response_cache_ray_artifact_smoke",
  "mc_histories": 0,
  "policy": "scientific",
  "llm_model": "deepseek-v4-flash",
  "llm_thinking": "disabled",
  "llm_reasoning_effort": "low",
  "llm_max_tokens": 384,
  "llm_timeout_s": 90,
  "llm_required": false,
  "max_causal_trials": 9,
  "random_baseline_trials": 0,
  "learning_shape_l1_limit": 0.20,
  "rotation_shape_l1_limit": 0.10,
