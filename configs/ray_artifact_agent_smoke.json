  "require_repeatability_for_attribution": true,
  "require_candidate_repeatability": true,
  "actions": [
    {
      "experiment_id": "coarse_baseline",
      "hypothesis": "Establish the coarse interface and dense-S_N baseline.",
      "n_pos": 1,
      "n_mu": 2,
      "n_phi": 16,
      "cfm_samples": 64,
      "oracle_samples": 64,
      "internal_samples": 128,
      "oracle_internal_samples": 128,
      "seed": 260827
    },
    {
      "experiment_id": "coarse_interface_rotation",
      "hypothesis": "Rotate only the interface angular grid to measure CFM and projected-MC orientation sensitivity.",
      "n_pos": 1,
      "n_mu": 2,
      "n_phi": 16,
      "cfm_samples": 64,
      "oracle_samples": 64,
      "internal_samples": 128,
      "oracle_internal_samples": 128,
      "seed": 260827,
      "interface_phi_offset_fraction": 0.25
    },
    {
      "experiment_id": "coarse_dense_rotation",
      "hypothesis": "Rotate only dense S_N to measure quadrature-locked sensitivity.",
      "n_pos": 1,
      "n_mu": 2,
      "n_phi": 16,
      "cfm_samples": 64,
      "oracle_samples": 64,
      "internal_samples": 128,
      "oracle_internal_samples": 128,
      "seed": 260827,
      "dense_phi_offset_fraction": 0.25
    },
    {
      "experiment_id": "coarse_repeat",
      "hypothesis": "Repeat the coarse experiment with a new seed to estimate stochastic sensitivity.",
      "n_pos": 1,
      "n_mu": 2,
      "n_phi": 16,
      "cfm_samples": 64,
      "oracle_samples": 64,
      "internal_samples": 128,
      "oracle_internal_samples": 128,
      "seed": 260828
    },
    {
      "experiment_id": "angular_refined",
      "hypothesis": "Increase only azimuthal resolution and test convergence away from the coarse grid.",
      "n_pos": 1,
      "n_mu": 2,
      "n_phi": 32,
      "cfm_samples": 64,
      "oracle_samples": 64,
      "internal_samples": 128,
      "oracle_internal_samples": 128,
      "seed": 260827
    },
    {
      "experiment_id": "angular_refined_rotation",
      "hypothesis": "Rotate the refined interface grid to test whether the candidate is robust.",
      "n_pos": 1,
      "n_mu": 2,
      "n_phi": 32,
      "cfm_samples": 64,
      "oracle_samples": 64,
      "internal_samples": 128,
      "oracle_internal_samples": 128,
      "seed": 260827,
      "interface_phi_offset_fraction": 0.25
    },
    {
      "experiment_id": "angular_refined_repeat",
      "hypothesis": "Repeat the refined candidate with a new seed to test stochastic stability.",
      "n_pos": 1,
      "n_mu": 2,
      "n_phi": 32,
      "cfm_samples": 64,
      "oracle_samples": 64,
      "internal_samples": 128,
      "oracle_internal_samples": 128,
      "seed": 260828
    },
    {
      "experiment_id": "coarse_certification",
      "hypothesis": "A finite global-MC run tests the cheaper coarse candidate if screening favors it.",
      "n_pos": 1,
      "n_mu": 2,
      "n_phi": 16,
      "cfm_samples": 64,
      "oracle_samples": 64,
      "internal_samples": 128,
      "oracle_internal_samples": 128,
      "seed": 260827,
      "mc_histories": 2000
    },
    {
      "experiment_id": "angular_refined_certification",
      "hypothesis": "A finite global-MC run checks flux-level consistency for the rotation-robust candidate.",
      "n_pos": 1,
      "n_mu": 2,
      "n_phi": 32,
      "cfm_samples": 64,
      "oracle_samples": 64,
      "internal_samples": 128,
      "oracle_internal_samples": 128,
      "seed": 260827,
      "mc_histories": 2000
    }
  ]
}
